<odoo>

    <record model="ir.ui.view" id="crm_lead_form_view">
        <field name="name">crm.lead.form (in crm_sequences)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <div>
                    <small>
                        <field name="code" />
                    </small>
                </div>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_lead_search_view">
        <field name="name">crm.lead.search (in crm_sequences)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="code" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_lead_tree_view">
        <field name="name">crm.lead.tree (in crm_sequences)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="code" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="crm_case_kanban_view_leads">
        <field name="name">crm.lead.kanban (in crm_sequences)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_kanban_content')]/div[hasclass('oe_kanban_details')]" position="after">
                <div>
                    <small>
                        <field name="code" />
                    </small>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
