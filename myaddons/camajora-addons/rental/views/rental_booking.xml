<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_booking_form_view">
    <field name="name">rental.booking.form (in rental)</field>
    <field name="model">rental.booking</field>
    <field name="arch" type="xml">
      <form create="false" edit="false">
        <header>
          <button name="action_confirm" states="draft" type="object" string="Confirm" class="btn-primary" />
          <button name="action_cancel" states="draft" type="object" string="Cancel" />
          <field name="state" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <group>
              <field name="date" />
              <field name="user_id" />
              <field name="rent_channel" />
            </group>
            <group>
              <field name="token" invisible="0" />
              <field name="qr_code" widget="image" invisible="0" class="oe_avatar" readonly="1" />
            </group>
          </group>
          <notebook>
            <page string="Slots">
              <field name="slot_ids" context="{'default_booking_id': active_id}">
                <tree>
                  <field name="name" />
                  <field name="resource_instance_id" />
                  <field name="location_id" />
                  <field name="partner_id" />
                  <field name="duration_id" />
                  <field name="dt_start" />
                  <field name="dt_end" />
                  <field name="total_hours" widget="hourseconds"/>
                </tree>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_booking_search_view">
    <field name="name">rental.booking.search (in rental)</field>
    <field name="model">rental.booking</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />

        <filter string="Data Prenotazione" name="date" date="date" default_period="today"/>
        <separator/>
        
        <filter name="draft" string="Bozza" domain="[('state','=','draft')]"/>
        <filter name="confirmed" string="Confermati" domain="[('state','=','confirmed')]"/>
        <filter name="canceled" string="Cancellati" domain="[('state','=','canceled')]"/>

        <filter name="group_booking_partner" string="Cliente" context="{'group_by':'user_id'}"/>

      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_booking_tree_view">
    <field name="name">rental.booking.tree (in rental)</field>
    <field name="model">rental.booking</field>
    <field name="arch" type="xml">
      <tree create="false" edit="false">
        <field name="name" />
        <field name="date" />
        <field name="user_id" />
        <field name="rent_channel" />
        <field name="state" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_booking_act_window">
    <field name="name">Prenotazioni</field>
    <field name="res_model">rental.booking</field>
    <field name="view_mode">tree,form,pivot</field>
    <field name="domain">[]</field>
    <field name="context">{
      'search_default_confirmed': 1,
      'backend':True
    }</field>
  </record>

</odoo>
