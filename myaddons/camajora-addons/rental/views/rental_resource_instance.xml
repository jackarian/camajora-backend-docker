<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_resource_instance_form_view">
    <field name="name">rental.resource.instance.form (in rental)</field>
    <field name="model">rental.resource.instance</field>
    <field name="arch" type="xml">
      <form>
        <header></header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-lock">
              <field name="active" widget="boolean_button" options='{"terminology": "active"}' />
            </button>
          </div>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <field name="resource_id" />
          </group>
          <notebook>
            <page string="Equipments">
              <field name="equipments_ids" />
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_instance_search_view">
    <field name="name">rental.resource.instance.search (in rental)</field>
    <field name="model">rental.resource.instance</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_instance_tree_view">
    <field name="name">rental.resource.instance.tree (in rental)</field>
    <field name="model">rental.resource.instance</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="resource_id" />
        <field name="booking_slots_count" />
        <field name="equipments_ids" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_resource_instance_act_window">
    <field name="name">Resource Instances</field>
    <field name="res_model">rental.resource.instance</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

</odoo>
