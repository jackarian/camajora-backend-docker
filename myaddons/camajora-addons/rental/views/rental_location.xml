<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_location_form_view">
    <field name="name">rental.location.form (in rental)</field>
    <field name="model">rental.location</field>
    <field name="arch" type="xml">
      <form>
        <header>

        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <field name="id"  readonly="1"/>
            <field name="partner_id"  readonly="1"/>
            <field name="description" />
            <field name="address" />
            <field name="postal_code" />
            <field name="city" />
            <field name="latitudo" />
            <field name="longitudo" />
            <field name="state_id" />
            <field name="country_id" />
            <field name="opened_from" widget="timepicker" options="{'datepicker': {'stepping': 30}}"/>
            <field name="opened_to"   widget="timepicker" options="{'datepicker': {'stepping': 30}}"/>
            <field name="resource_ids"/>
          </group>
          <notebook>
            <page string="Contact Info">
              <group>
                <field name="contact_email_ref"/>
                <field name="contact_mobile_ref"/>
                <field name="contact_name_ref" string="Name"/>
              </group>
            </page>
            <page string="Network Service Access Info">
              <group>
                <field name="hotspot_name"/>
                <field name="scc_address"/>
                <field name="ip_device_door_opening"/>
              </group>
            </page>
            <page string="API Door Opening Config">
              <group>
                <field name="scc_endpoint_open_door" string="API"/>
                <field name="scc_endpoint_open_door_protocol" string="Protocol"/>
                <field name="scc_endpoint_open_door_port" string="Port"/>
              </group>
            </page>
            <page string="API Resource Activation Config">
              <group>
                <field name="scc_endpoint_resource_activation" string="API"/>
                <field name="scc_endpoint_resource_activation_protocol" string="Protocol"/>
                <field name="scc_endpoint_resource_activation_port" string="Port"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_location_search_view">
    <field name="name">rental.location.search (in rental)</field>
    <field name="model">rental.location</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="partner_id" />
        <field name="description" />
        <field name="address" />
        <field name="postal_code" />
        <field name="city" />
        <field name="state_id" />
        <field name="country_id" />

        <filter name="group_location_partner" string="Proprietario" context="{'group_by':'partner_id'}"/>

      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_location_tree_view">
    <field name="name">rental.location.tree (in rental)</field>
    <field name="model">rental.location</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="partner_id" />
        <field name="description" />
        <field name="address" />
        <field name="postal_code" />
        <field name="city" />
        <field name="state_id" />
        <field name="country_id" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_location_act_window">
    <field name="name">Locations</field>
    <field name="res_model">rental.location</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'backend':True}</field>
  </record>

</odoo>
