<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_resource_size_form_view">
    <field name="name">rental.resource.size.form (in rental)</field>
    <field name="model">rental.resource.size</field>
    <field name="arch" type="xml">
      <form>
        <header></header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <field name="description" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_size_search_view">
    <field name="name">rental.resource.size.search (in rental)</field>
    <field name="model">rental.resource.size</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_size_tree_view">
    <field name="name">rental.resource.size.tree (in rental)</field>
    <field name="model">rental.resource.size</field>
    <field name="arch" type="xml">
      <tree>
        <field name="sequence" widget="handle" />
        <field name="name" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_resource_size_act_window">
    <field name="name">Resource Sizes</field>
    <field name="res_model">rental.resource.size</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

</odoo>
