<odoo>
  <record model="ir.ui.view" id="rental_kafka_form_view">
    <field name="name">rental.kafka.topic.configuration.form (in rental)</field>
    <field name="model">rental.kafka.configuration</field>
    <field name="arch" type="xml">
      <form>
        <header></header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <field name="description" />
            <field name="model" />
            <field name="security_protocol" />
            <field name="sasl_mechanism" />
            <field name="sasl_plain_username" />
            <field name="sasl_plain_password" />
            <field name="bootstrap_servers" />
            <field name="topic" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_kafka_search_view">
    <field name="name">rental.kafka.topic.configuration.search (in rental)</field>
    <field name="model">rental.kafka.configuration</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="model" />
        <field name="topic" />
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_kafka_tree_view">
    <field name="name">rental.kafka.topic.configuration.tree (in rental)</field>
    <field name="model">rental.kafka.configuration</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="model" />
        <field name="topic" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_kafka_act_window">
    <field name="name">Rental Kafka Topic Configuration</field>
    <field name="res_model">rental.kafka.configuration</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>
</odoo>