<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="home_config_form_view">
    <field name="name">rental.website.home.form (in rental)</field>
    <field name="model">rental.website.home</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <field name="image" widget="image" class="oe_avatar" nolabel="1" />
          <group>
            <group>
              <field name="title" />
              <field name="subtitle" />
            </group>
            <group>
              <field name="explore_title" />
              <field name="explore_subtitle" />
            </group>
            <group>
              <field name="about_text_left" />
              <field name="about_text_right" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.actions.act_window" id="home_config_act_window">
    <field name="name">Home Configuration</field>
    <field name="res_model">rental.website.home</field>
    <field name="res_id" ref="home_placeholder_data"></field>
    <field name="view_mode">form</field>
    <field name="domain">[]</field>
    <field name="target">current</field>
  </record>

</odoo>
