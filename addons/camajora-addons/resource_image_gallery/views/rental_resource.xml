<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="rental_resource_form_view" model="ir.ui.view">
    <field name="model">rental.resource</field>
    <field name="inherit_id" ref="rental.rental_resource_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//page[@name='description']" position="after">
        <page name="gallery" string="Gallery">
          <field name="image_ids" mode="kanban" context="{'active_model': 'rental.resource'}" />
        </page>
      </xpath>
    </field>
  </record>
</odoo>
