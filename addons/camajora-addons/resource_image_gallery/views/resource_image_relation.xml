<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="resource_image_relation_form" model="ir.ui.view">
    <field name="model">resource.image.relation</field>
    <field name="inherit_id" ref="fs_base_multi_image.fs_image_relation_mixin_form_view" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <group name="extra" position="inside">
        <field name="tag_id" context="{'active_model': context.get('active_model')}" />
      </group>
    </field>
  </record>

  <record id="resource_image_relation_kanban" model="ir.ui.view">
    <field name="model">resource.image.relation</field>
    <field name="inherit_id" ref="fs_base_multi_image.fs_image_relation_mixin_kanban_view" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
      <xpath expr="//kanban/field[@name='image']" position="after">
        <field name="tag_id" />
      </xpath>
      <xpath expr="//div[hasclass('o_kanban_image')]" position="inside">
        <img t-att-src="kanban_image('resource.image.relation', 'image_medium', record.id.raw_value)"
             t-if="record.id" alt="Image" class="o_image_64_contain" />
      </xpath>
      <xpath expr="//div[@name='extra']" position="inside">
        <field name="tag_id" />
      </xpath>
    </field>
  </record>
</odoo>
