    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="name">Quotations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="domain">[('typology', '=', 'sale')]</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Create a Quotation, the first step of a new sale.
            </p>
            <p>
            Your next actions should flow efficiently: confirm the Quotation
            to a Sales Order, then create the Invoice and collect the Payment.
            </p>
        </field>
    </record>

    <record id="sale_order_view_form_inherit" model="ir.ui.view">
            <field name="name">sale.order.form (in rest_shop)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                    <button name="action_accept_order" string="Accept Order" type="object" invisible="state != 'review'"/>
                    <button name="action_back_draft" string="Back to Draft" type="object" invisible="state != 'review'"/>
            </header>
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,review,sent,sale"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_cart_inherit_sale" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.sale.cart</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Abandoned Carts" name="abandoned_cart" domain="[('typology','=','cart'), ('state','=','draft'),('order_line.product_uom_qty','>=',0)]"/>
                <separator/>
            </xpath>
        </field>
    </record>
    <record id="action_carts" model="ir.actions.act_window">
        <field name="name">Carts</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.order</field>
        <field name="domain">[('typology', '=', 'cart')]</field>
        <field name="view_id" ref="sale.view_quotation_tree"/>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="context">{'search_default_abandoned_cart': 1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
            Create a Cart, the first step of a new sale.
            </p>
            <p>
            Your next actions should flow efficiently: confirm the Quotation
            to a Sales Order, then create the Invoice and collect the Payment.
            </p>
        </field>
    </record>
    <menuitem id="menu_sale_carts" action="action_carts" parent="sale.sale_order_menu" sequence="2" groups="sales_team.group_sale_salesman"/>
</odoo>
