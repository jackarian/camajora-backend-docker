<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_credits_partner_form_view">
    <field name="name">res.partner.form (in rental_credits)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Wallet">
          <group>
            <field  name="check_superuser" invisible="True"/>
            <field  name="credits" invisible="not check_superuser"/>
            <field  name="credits_available" invisible="check_superuser"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
