<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="product_template_form_view">
    <field name="name">product.template.form (in rental_credits)</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_only_form_view" />
    <field name="arch" type="xml">
      <field name="categ_id" position="before">
        <field name="is_credits" />
        <field name="credits_value" invisible="not is_credits" />
      </field>
      <xpath expr="//div[@name='options']" position="inside">
        <div>
          <field name="website_ok"/>
          <label for="website_ok"/>
        </div>
      </xpath>
    </field>
  </record>

  <record model="ir.ui.view" id="product_template_tree_view">
    <field name="name">product.template.tree (in rental_credits)</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view" />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="is_credits" />
        <field name="credits_value" invisible="not is_credits" />
      </field>
    </field>
  </record>

  <record model="ir.actions.act_window" id="product_template_act_window">
    <field name="name">Products</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

</odoo>
