<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="res_partner_rule_private_employee" model="ir.rule">
    <field name="name">res.partner.rule.private.employee (in Rental)</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="domain_force">
      ['|',('id','=',user.partner_id.id), ('id','=',user.partner_id.parent_id.id)]
    </field>
    <field name="groups" eval="[(4, ref('base.group_user'))]" />
    <field name="perm_read" eval="True" />
    <field name="perm_write" eval="False" />
    <field name="perm_create" eval="False" />
    <field name="perm_unlink" eval="False" />
  </record>

  <record id="res_partner_rule_private_owner" model="ir.rule">
    <field name="name">res.partner.rule.private.owner (in Rental)</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="domain_force">
      ['|',('id','=',user.partner_id.id), ('id','in',user.partner_id.booking_users.ids)]
    </field>
    <field name="groups" eval="[(4, ref('rental.group_rental_owner'))]" />
    <field name="perm_read" eval="True" />
    <field name="perm_write" eval="False" />
    <field name="perm_create" eval="False" />
    <field name="perm_unlink" eval="False" />
  </record>

  <record id="res_partner_rule_access_to_partners" model="ir.rule">
    <field name="name">res.partner.rule.access_to_partners</field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="domain_force">
      ['|', ('type', '!=', 'private'), ('type', '=', False)]
    </field>
    <field name="groups" eval="[(4, ref('rental.group_access_to_partners'))]" />
    <field name="perm_read" eval="True" />
    <field name="perm_write" eval="False" />
    <field name="perm_create" eval="False" />
    <field name="perm_unlink" eval="False" />
  </record>
</odoo>
