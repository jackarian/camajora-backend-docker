<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record model="ir.ui.view" id="rental_resource_tree_view">
    <field name="name">rental.resource.tree (in rental)</field>
    <field name="model">rental.resource</field>
    <field name="create">False</field>
    <field name="arch" type="xml">
      <tree decoration-danger="instance_count == 0"  default_order="name desc">
        <field name="code" />
        <field name="name" />
        <field name="type_id" />
        <field name="location_id" />
        <field name="partner_id" />
        <field name="instance_count" />
        <button name="%(open_my_wizard)d"
                    string="Prenotazione"
                    type="action"
                    help="Prenota"
                    attrs="{'invisible':[('instance_count','=',0)]}"
                    context="{'default_resource_id':True}"
                    class="oe_highlight" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_resource_act_window">
    <field name="name">Resources</field>
    <field name="res_model">rental.resource</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{'backend':True}</field>
  </record>

  <record model="ir.ui.view" id="rental_resource_form_view">
    <field name="name">rental.resource.form (in rental)</field>
    <field name="model">rental.resource</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button type="action" name="%(rental.generate_instances_wizard_action)d" string="Generate Instances"
                  attrs="{'invisible': True}" class="btn-primary" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" attrs="{'invisible':True}" icon="fa-calendar" name="action_open_calendar" type="object">
              <field name="instance_count" string="Calendar" widget="statinfo" />
            </button>
            <button class="oe_stat_button"  attrs="{'invisible':True}" icon="fa-child" name="action_open_instances" type="object">
              <field name="instance_count" string="Instances" widget="statinfo" />
            </button>
            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-lock">
              <field name="active" widget="boolean_button" options='{"terminology": "active"}' />
            </button>
          </div>
          <field name="image" widget="image" class="oe_avatar" nolabel="1" />
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <group>
              <field name="code" />
              <field name="type_id" widget="many2one_tags"/>
              <field name="location_id" options="{'no_quick_create': True, 'no_create_edit' : True}" widget="many2one_tags" context="[('location_id.id','=',active_id)]"/>
              <field name="partner_id" />
            </group>
            <group>
              <field name="category_id" />
              <field name="setup_id" />
              <field name="size_id" />
              <field name="performance_id" />
              <field name="availability_id"/>
              <field name="duration_id" />
            </group>
          </group>
          <notebook>
            <page name="description" string="Description">
              <field name="description" widget="html" />
            </page>
            <page name="instances" string="Instances" attrs="{'invisible':True}" >
              <field name="instances_ids" context="{'default_resource_id': active_id}">
                <tree>
                  <field name="code" />
                  <field name="equipments_ids" widget="many2many_tags" />
                </tree>
              </field>
            </page>
            <page string="Technical Settings">
              <group>
                <field name="door_present"/>
                <field name="modbus_group"/>
                <field name="modbus_id"/>
                <field name="modbus_plugin"/>
              </group>
              <group>
                <field name="api_url"/>
                <field name="api_key"/>
                <field name="api_path"/>
                <field name="plugin_type"/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_search_view">
    <field name="name">rental.resource.search (in rental)</field>
    <field name="model">rental.resource</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="code" />
        <field name="type_id" />
        <field name="location_id" />
        <field name="partner_id" />
        <field name="category_id" />
        <field name="setup_id" />
        <field name="size_id" />
        <field name="performance_id" />
        <field name="availability_id" />
        <field name="duration_id" />

        <filter name="group_resource_type" string="Tipo" context="{'group_by':'type_id'}" />
        <filter name="group_resource_location" string="Location" context="{'group_by':'location_id'}" />
        <filter name="group_resource_category" string="Categoria" context="{'group_by':'category_id'}" />
        <filter name="group_resource_partner" string="Proprietario" context="{'group_by':'partner_id'}" />
      </search>
    </field>
  </record>

</odoo>
