<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <!-- Email template for reset password -->
    <record id="reservation_confirm_email" model="mail.template">
        <field name="name">Send qrcode to user for reservation</field>
        <field name="model_id" ref="rental.model_rental_booking_slot"/>
        <field name="subject">Reservation</field>
        <field name="email_from">${object.owner_id.email | safe}</field>
        <field name="email_to">${object.partner_id.email | safe}</field>
        <field name="auto_delete" eval="True"/>
        <field name="body_html"><![CDATA[
<div style="padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777">
  <p>Info prenotazione;</p>
  <p>Location: ${object.location_id.name}</p>
  <p>Quando: </p>
  <p>&nbsp; dal&nbsp;${object.dt_start}</p>
  <p>&nbsp; al&nbsp;&nbsp;${object.dt_end}</p>
  <p>Qrcode da utilizzare per l'attivazione all'interno della struttura<br></p>
  <p><img src="data:image/png;base64,${object.booking_id.qr_code.decode('utf-8')}" width="300px" height="300px"></p>
  <p>Saluti ${object.owner_id.name}</p>
</div>]]></field>
        </record>
  </data>

</odoo>