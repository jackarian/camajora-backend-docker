<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_booking_slot_form_view">
    <field name="name">rental.booking.slot.form (in rental)</field>
    <field name="model">rental.booking.slot</field>
    <field name="arch" type="xml">
      <form create="false" edit="false">
        <header>
          <field name="state" widget="statusbar"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <group>
              <field name="partner_id" />
              <field name="booking_id" />
              <field name="location_id" />
              <field name="resource_id" />
              <field name="resource_instance_id" />
            </group>
            <group>
              <field name="duration" invisible="True" />
              <field name="duration_id" />

              <field name="start_date" />
              <field name="end_date" invisible="duration in ['hourly', 'half_daily']" />

              <field name="start_time" invisible="duration != 'hourly'" widget="timepicker" options="{'datepicker': {'stepping': 30}}" />
              <field name="end_time" invisible="duration != 'hourly'" widget="timepicker" options="{'datepicker': {'stepping': 30}}"/>

              <field name="half_day_type" invisible="duration != 'half_daily'" />

              <field name="total_hours"/>
              <field name="dt_start" />
              <field name="dt_end" />
            </group>

            <group>
              <field name="unlock_link" widget="url" readonly="1" text="Link di apertura"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_booking_slot_search_view">
    <field name="name">rental.booking.slot.search (in rental)</field>
    <field name="model">rental.booking.slot</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="partner_id" />
        <field name="location_id" />
        <field name="owner_id" />
        <field name="resource_id" />
        <field name="booking_id" />

        <filter name="draft" string="Bozza" domain="[('state','=','draft')]"/>
        <filter name="confirmed" string="Confermato" domain="[('state','=','confirmed')]"/>
        <filter name="cancelled" string="Cancellato" domain="[('state','=','cancelled')]"/>

        <filter name="group_slot_location" string="Location" context="{'group_by':'location_id'}"/>
        <filter name="group_slot_resource" string="Risorsa" context="{'group_by':'resource_id'}"/>
        <filter name="group_slot_booking" string="Prenotazione" context="{'group_by':'booking_id'}"/>

        <separator/>
        <filter string="Date" name="create_date" date="create_date" default_period="last_month"/>

      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_booking_slot_tree_view">
    <field name="name">rental.booking.slot.tree (in rental)</field>
    <field name="model">rental.booking.slot</field>
    <field name="arch" type="xml">
      <tree>
        <field name="location_id" />
        <field name="partner_id" />
        <field name="resource_id" />
        <field name="name" />
        <field name="booking_id" />
        <field name="duration_id" />
        <field name="dt_start" />
        <field name="dt_end" />
        <field name="total_hours" />
        <field name="state" />
      </tree>
    </field>
  </record>
  <record model="ir.ui.view" id="rental_booking_slot_calendar_view">
    <field name="name">rental.booking.slot.calendar (in rental)</field>
    <field name="model">rental.booking.slot</field>
    <field name="arch" type="xml">
      <calendar  color="partner_id" date_start="dt_start"
                 date_stop="dt_end" string="Prenotazioni">
        <field name="booking_id"/>
        <field name="name" />
        <field name="resource_id" />
        <field name="location_id" />
        <field name="partner_id" />
        <field name="formatted_total_hours" />
      </calendar>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_booking_slot_act_window">
    <field name="name">Booking Slots</field>
    <field name="res_model">rental.booking.slot</field>
    <field name="view_mode">calendar</field>
    <field name="domain">[]</field>
    <field name="context">{
      'search_default_confirmed': 1,
      'backend':True
    }</field>
  </record>

</odoo>
