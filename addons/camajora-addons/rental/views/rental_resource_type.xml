<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_resource_type_form_view">
    <field name="name">rental.resource.type.form (in rental)</field>
    <field name="model">rental.resource.type</field>
    <field name="arch" type="xml">
      <form>
        <header></header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-lock">
              <field name="active" widget="boolean_button" options='{"terminology": "active"}' />
            </button>
          </div>
          <field name="image" widget="image" class="oe_avatar" nolabel="1" />
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <field name="description" />
          </group>
          <group>
            <group>
              <field name="category_id" />
              <field name="setup_id" />
              <field name="size_id" />
              <field name="performance_id" />
            </group>
            <group>
              <field name="availability_id" />
              <field name="duration_id" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_type_search_view">
    <field name="name">rental.resource.type.search (in rental)</field>
    <field name="model">rental.resource.type</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_type_tree_view">
    <field name="name">rental.resource.type.tree (in rental)</field>
    <field name="model">rental.resource.type</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_resource_type_act_window">
    <field name="name">Resource Types</field>
    <field name="res_model">rental.resource.type</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

</odoo>
