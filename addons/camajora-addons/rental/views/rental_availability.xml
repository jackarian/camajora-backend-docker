<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_availability_form_view">
    <field name="name">rental.availability.form (in rental)</field>
    <field name="model">rental.availability</field>
    <field name="arch" type="xml">
      <form>
        <header></header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <field name="description" />
            <field name="starthour" widget="timepicker" options="{'datepicker': {'stepping': 30}}" />
            <field name="endhour" widget="timepicker" options="{'datepicker': {'stepping': 30}}" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_availability_search_view">
    <field name="name">rental.availability.search (in rental)</field>
    <field name="model">rental.availability</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_availability_tree_view">
    <field name="name">rental.availability.tree (in rental)</field>
    <field name="model">rental.availability</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_availability_act_window">
    <field name="name">Rental Availabilities</field>
    <field name="res_model">rental.availability</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

</odoo>
