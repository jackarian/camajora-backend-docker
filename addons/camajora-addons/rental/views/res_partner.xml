<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record model="ir.ui.view" id="rental_partner_search_view">
    <field name="name">res.partner.search (in rental)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter" />
    <field name="arch" type="xml">
      <filter name="type_company" position="after">
        <filter string="Owner" name="owner" domain="[('is_owner','=',True)]" help="Owner" />
      </filter>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_partner_form_view">
    <field name="name">res.partner.form (in rental)</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
       <xpath expr="//sheet/div[@name='button_box']" position="before">
             <button class="oe_stat_button" type="object" name="action_slots" groups="rental.group_rental_api,rental.group_rental_owner" invisible="is_company" icon="fa-bookmark">
            <field string="Bookings" name="booking_count" widget="statinfo"/>
        </button>

        <button class="oe_stat_button" type="object" name="action_booking_slots" groups="rental.group_rental_api,rental.group_rental_owner" invisible="is_company" icon="fa-bookmark-o">
            <field string="Bookings Slot" name="booking_slot_count" widget="statinfo"/>
        </button>
       </xpath>
      <field name="vat" position="after">
        <field name="fiscal_code" />
        <field name="invoice_recipient_code" />
        <field name="pec_address" />
        <field name="is_owner" />
        <field name="is_superuser" />
      </field>
    </field>
  </record>


</odoo>
