<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_duration_form_view">
    <field name="name">rental.duration.form (in rental)</field>
    <field name="model">rental.duration</field>
    <field name="arch" type="xml">
      <form>
        <header></header>
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" />
            </h1>
          </div>
          <group>
            <field name="description" />
            <field name="type" />
            <field name="discount" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_duration_search_view">
    <field name="name">rental.duration.search (in rental)</field>
    <field name="model">rental.duration</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" />
        <field name="type" />
        <field name="discount" />
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_duration_tree_view">
    <field name="name">rental.duration.tree (in rental)</field>
    <field name="model">rental.duration</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="type" />
        <field name="discount" />
      </tree>
    </field>
  </record>

  <record model="ir.actions.act_window" id="rental_duration_act_window">
    <field name="name">Rental Durations</field>
    <field name="res_model">rental.duration</field>
    <field name="view_mode">tree,form</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

</odoo>
